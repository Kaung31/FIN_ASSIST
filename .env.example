# ── Mode ─────────────────────────────────────────────────────────────────────
# Mock mode is the default: all three Azure services are mocked, so the pipeline and
# tests run at zero cost. Flip to false once the keys below are filled in.
MOCK_MODE=true

# ── Azure OpenAI (chat + embeddings) ──────────────────────────────────────────
# Endpoint MUST be the bare resource URL ending in .openai.azure.com/ — do NOT append
# /openai, /openai/v1, or /deployments (the SDK adds the path).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment NAMES (not model names) you created in the Azure OpenAI resource:
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must equal the index vector dimension: 3-small=1536, 3-large=3072.
EMBEDDING_DIMENSIONS=1536

# ── Azure AI Search (hybrid + semantic ranker) ────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=earnings-index
# Semantic ranker needs Standard tier or above (set false only if you must use a lower tier).
AZURE_SEARCH_USE_SEMANTIC_RANKER=true

# ── Azure Document Intelligence (parsing) ─────────────────────────────────────
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# ── Eval / tracing ────────────────────────────────────────────────────────────
ENABLE_PHOENIX=false

# ── App ───────────────────────────────────────────────────────────────────────
# If true, prefer DefaultAzureCredential (Managed Identity / az login) over the *_KEY values.
USE_AAD_AUTH=false
LOG_LEVEL=INFO
